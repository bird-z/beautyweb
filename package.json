{
  "name": "bioqif-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:server": "npm --prefix server run dev",
    "build:web": "npm --prefix web run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:web && npm run build:server",
    "preview:web": "npm --prefix web run preview",
    "start:server": "npm --prefix server run start",
    "migrate": "npm --prefix server run migrate",
    "generate:types": "npm --prefix server run generate:types",
    "generate:importmap": "npm --prefix server run generate:importmap",
    "lint:web": "npm --prefix web run lint --if-present",
    "seed": "npm --prefix server run seed"
  }
}
